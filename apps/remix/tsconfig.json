{
  "include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "paths": {
      "~/*": ["./app/*"],
      // server/* — app code and the server tree both import these as bare
      // specifiers (e.g. `import { getLoaderSession } from
      // "server/utils/get-loader-session"`). The files exist at
      // apps/remix/server/, but a NON-RELATIVE specifier has no root to
      // resolve against unless it is named here or baseUrl is set, so tsc
      // reported TS2307 "Cannot find module 'server/context'" for files
      // sitting right there and failed `turbo run build`.
      //
      // A paths entry rather than baseUrl: baseUrl would change resolution for
      // every bare specifier in the project, letting any top-level directory
      // shadow a package of the same name. This maps exactly the one prefix
      // that needs it.
      "server/*": ["./server/*"],
      "@hanzo/esign-api": ["../../packages/api"],
      "@hanzo/esign-assets": ["../../packages/assets"],
      "@hanzo/esign-auth": ["../../packages/auth"],
      "@hanzo/esign-lib": ["../../packages/lib"],
      "@hanzo/esign-prisma": ["../../packages/prisma"],
      "@hanzo/esign-trpc": ["../../packages/trpc"],
      "@hanzo/esign-ui": ["../../packages/ui"],
      "@hanzo/esign-tailwind-config": ["../../packages/tailwind-config"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "useUnknownInCatchVariables": false
  }
}
